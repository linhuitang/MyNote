[Unit]
Description=Synchronize and deploy MyNote from GitHub
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
EnvironmentFile=-/etc/default/mynote-sync
ExecStart=/bin/sh -c 'exec "${MYNOTE_REPOSITORY}/deploy/mynote-sync.sh"'
TimeoutStartSec=15min
